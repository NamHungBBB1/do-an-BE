{
  "schemaVersion": 2,
  "note": "Bộ khuôn nội dung game — BE quyết khung (Hưng 24/10). Spec build/spec-bo-khuon-noi-dung-2026-10-24.md. Studio dựng form từ đây; BE kiểm nháp theo đây; FE game chọn khung theo type / game.kind, không theo id.",
  "stats": [
    { "key": "SAVING", "label": "Tiết kiệm", "initial": 50 },
    { "key": "HAPPINESS", "label": "Hạnh phúc", "initial": 50 },
    { "key": "RISK", "label": "Rủi ro", "initial": 30 },
    { "key": "GOAL", "label": "Mục tiêu", "initial": 50 },
    { "key": "WEALTH", "label": "Tài sản", "initial": 0 }
  ],
  "variables": ["money", "miniGameScore", "SAVING", "HAPPINESS", "RISK", "GOAL", "WEALTH", "flag:*", "inspected:*", "choice:*"],
  "variablesNote": "flag:<tên> = cờ việc không phải lựa chọn (đã mở thẻ, đã kiểm nguồn…); inspected:<mã thẻ> = trẻ đã mở thẻ / vật đó; choice:<nhóm> = lựa chọn cuối của một câu hỏi (nhóm = choiceGroup, không có thì = mã cảnh), so sánh == / != với mã lựa chọn (Hưng 24/10).",
  "conditionOps": ["==", "!=", ">", ">=", "<", "<="],
  "conditionExample": { "all": [ { "var": "money", "op": ">=", "value": 500000 }, { "any": [ { "var": "choice:CH04_SC02", "op": "==", "value": "CH04_SC02_A" }, { "var": "inspected:ch04_compare", "op": "==", "value": true } ] } ] },
  "positions": ["left", "center", "right"],
  "commonSceneFields": {
    "id": { "type": "string", "required": true, "label": "Mã cảnh" },
    "title": { "type": "string", "label": "Tiêu đề" },
    "background": { "type": "image", "label": "Ảnh nền" },
    "characters": { "type": "characters", "label": "Nhân vật trên cảnh" },
    "speaker": { "type": "string", "label": "Tên người nói (hiển thị)" },
    "speakerId": { "type": "string", "label": "Mã nhân vật nói (gắn giọng)" },
    "knowledgeUnits": { "type": "array", "label": "Mã khái niệm" },
    "voice": { "type": "string", "label": "Giọng (trống = theo nhân vật, off = tắt)" },
    "spokenText": { "type": "string", "label": "Chữ để đọc (giọng)" },
    "setFlags": { "type": "flags", "label": "Bật / tắt cờ khi vào cảnh {tên: true|false}" }
  },
  "sceneTypes": {
    "dialogue": {
      "label": "Thoại",
      "fields": {
        "text": { "type": "string", "required": true, "label": "Lời thoại" },
        "nextSceneId": { "type": "sceneRef", "label": "Cảnh kế tiếp" }
      }
    },
    "inspect": {
      "label": "Bấm để xem",
      "aliases": ["scene"],
      "fields": {
        "text": { "type": "string", "label": "Chữ" },
        "sceneArt": { "type": "image", "label": "Ảnh minh hoạ" },
        "inspect": { "type": "inspect", "label": "Vật bấm để xem" },
        "nextSceneId": { "type": "sceneRef", "label": "Cảnh kế tiếp" }
      }
    },
    "choice": {
      "label": "Lựa chọn",
      "fields": {
        "text": { "type": "string", "label": "Câu hỏi / lời dẫn" },
        "prompt": { "type": "string", "label": "Gợi ý" },
        "choiceGroup": { "type": "string", "label": "Nhóm lựa chọn" },
        "options": { "type": "options", "required": true, "minItems": 1, "warnBelowItems": 2, "label": "Các lựa chọn" }
      }
    },
    "minigame": {
      "label": "Mini-game",
      "fields": {
        "game": { "type": "game", "required": true, "label": "Mini-game" },
        "onPassSceneId": { "type": "sceneRef", "label": "Làm xong thì sang (tên cũ của nextSceneId)" },
        "nextSceneId": { "type": "sceneRef", "label": "Cảnh kế tiếp" }
      }
    },
    "conditional": {
      "label": "Rẽ nhánh theo điều kiện",
      "fields": {
        "condition": { "type": "condition", "required": true, "label": "Điều kiện" },
        "ifTrueSceneId": { "type": "sceneRef", "required": true, "label": "Đúng thì sang" },
        "ifFalseSceneId": { "type": "sceneRef", "required": true, "label": "Sai thì sang" }
      }
    },
    "reflection": {
      "label": "Tự suy ngẫm",
      "aliases": ["activity"],
      "fields": {
        "prompt": { "type": "string", "label": "Câu hỏi suy ngẫm" },
        "nextSceneId": { "type": "sceneRef", "label": "Cảnh kế tiếp" }
      }
    },
    "summary": {
      "label": "Tổng kết",
      "fields": { "text": { "type": "string", "label": "Chữ" }, "nextSceneId": { "type": "sceneRef", "label": "Cảnh kế tiếp" } }
    },
    "cutscene": {
      "label": "Cảnh chuyển",
      "fields": { "text": { "type": "string", "label": "Chữ" }, "nextSceneId": { "type": "sceneRef", "label": "Cảnh kế tiếp" } }
    },
    "ending": {
      "label": "Kết chương",
      "fields": { "text": { "type": "string", "label": "Chữ" } }
    }
  },
  "optionFields": {
    "id": { "type": "string", "required": true, "label": "Mã lựa chọn" },
    "text": { "type": "string", "requiredOneOf": ["text", "label"], "label": "Chữ lựa chọn" },
    "nextSceneId": { "type": "sceneRef", "label": "Chọn xong sang" },
    "condition": { "type": "condition", "label": "Điều kiện mở (chưa đủ thì lựa chọn bị khoá)" },
    "lockedReason": { "type": "string", "label": "Câu nhắn cho trẻ khi bị khoá (bắt buộc nếu có điều kiện mở)" },
    "deltaStats": { "type": "stats", "label": "Cộng / trừ chỉ số" },
    "moneyEvents": { "type": "array", "label": "Thay đổi tiền" },
    "setFlags": { "type": "flags", "label": "Bật / tắt cờ {tên: true|false} — chỉ cho việc không phải lựa chọn; ghi nhớ lựa chọn dùng choice:<nhóm>" },
    "evidenceScores": { "type": "object", "label": "Điểm bằng chứng I / C / P" }
  },
  "grading": {
    "note": "Câu chấm điểm = đối tượng có trường grade nằm trong game của cảnh mini-game; BE chấm bằng một hàm chung (spec build/spec-cham-minigame-be-2026-10-24.md). FE gửi trẻ nhập gì ở từng ô nhập (miniGames[].itemId = mã ô, chosen = giá trị JSON), không gửi đúng / sai.",
    "fields": {
      "id": { "type": "string", "label": "Mã câu — mặc định = id của đối tượng chứa grade; không trùng trong một mini-game" },
      "input": { "type": "string", "label": "Mã ô nhập FE gửi — mặc định = mã câu" },
      "part": { "type": "string|number", "label": "Câu thuộc vòng / phần nào — cảnh chỉ chấm câu thuộc game.rounds hoặc game.config.mode" },
      "concept": { "type": "string", "label": "Khái niệm (mã knowledgeUnit) — mặc định = knowledgeUnits của cảnh nếu cảnh có đúng 1 mã" },
      "rule": { "type": "rule", "label": "Đáp án / luật — một lá hoặc all / any" }
    },
    "comparators": {
      "eq": "bằng (đáp án số so theo giá trị: \"15\" = 15)",
      "in": "thuộc một trong các giá trị",
      "sets": "mảng trẻ chọn, coi như tập, bằng đúng một trong các tập",
      "has": "mảng trẻ chọn chứa đủ các giá trị",
      "at": "{item, in: [vị trí]} — vị trí của item trong mảng thứ tự",
      "count": "{min, max} — số phần tử của mảng",
      "min": "số ≥",
      "max": "số ≤"
    },
    "modifiers": {
      "input": "lá đọc ô nhập khác ô của câu",
      "field": "lấy một trường của giá trị object",
      "sum": "cộng các trường của giá trị object",
      "sumOf": "{from: đường dẫn mảng trong game, field} — giá trị là mảng id, cộng trường của các món đó"
    },
    "groups": { "all": "tất cả luật con đúng", "any": "ít nhất một luật con đúng" },
    "example": { "id": "ITEM_MEAL", "label": "Bữa ăn", "category": "NEEDS", "grade": { "concept": "D01.02", "rule": { "eq": "NEEDS" } } }
  },
  "minigameKinds": {
    "NEED_WANT": { "phase": "A", "label": "Phân loại Cần / Muốn", "frame": "NeedWantMiniGame", "legacyIds": ["NEEDS_OR_WANTS_CH01"], "graded": true },
    "BUDGET_BUILDER": { "phase": "A", "label": "Chia tiền vào phong bì", "frame": "BudgetBuilderMiniGame", "legacyIds": ["BUDGET_BUILDER_CH02"], "graded": true },
    "SAVINGS_RACE": { "phase": "A", "label": "Đua tiết kiệm (mô phỏng)", "frame": "SavingsRaceMiniGame", "legacyIds": ["SAVINGS_RACE_CH02"], "graded": false },
    "CAREER_MATCH": { "phase": "A", "label": "Ghép việc làm thêm + tính giờ", "frame": "CareerMatchMiniGame", "legacyIds": ["CAREER_MATCH_CH03"], "graded": true },
    "SMART_SHOPPING": { "phase": "A", "label": "Mua sắm thông minh", "frame": "SmartShoppingMiniGame", "legacyIds": ["SMART_SHOPPING_CH04"], "graded": true },
    "COMPOUND_TIMELINE": { "phase": "A", "label": "Dòng thời gian lãi kép", "frame": "CompoundTimelineMiniGame", "legacyIds": ["COMPOUND_TIMELINE_CH05"], "graded": true },
    "LOAN_DETECTIVE": { "phase": "A", "label": "Thám tử khoản vay", "frame": "LoanDetectiveMiniGame", "legacyIds": ["LOAN_OFFERS_CH06", "LOAN_REPAYMENT_CH06"], "graded": true },
    "SCAM_OR_SAFE": { "phase": "A", "label": "Bảo hiểm và lừa đảo", "frame": "ScamOrSafeMiniGame", "legacyIds": ["INSURANCE_DESK_CH07", "SCAM_OR_SAFE_CH07"], "graded": true },
    "FUTURE_PLAN": { "phase": "A", "label": "Kế hoạch tương lai", "frame": "FuturePlanMiniGame", "legacyIds": ["PORTFOLIO_CH08", "CLAIM_REVIEW_CH08", "LIFE_PLAN_CH08"], "graded": true }
  },
  "stepKinds": {
    "SORT": { "phase": "B", "label": "Phân loại thẻ vào nhóm" },
    "ALLOCATE": { "phase": "B", "label": "Chia vào ô" },
    "MULTIPLE_CHOICE": { "phase": "B", "label": "Chọn một đáp án" },
    "MULTI_SELECT": { "phase": "B", "label": "Chọn mọi đáp án đúng" },
    "NUMERIC": { "phase": "B", "label": "Nhập số" },
    "THRESHOLD_CLASSIFY": { "phase": "B", "label": "Xếp theo ngưỡng" },
    "SIMULATION": { "phase": "B", "label": "Mô phỏng (không vào điểm)" },
    "INFO": { "phase": "B", "label": "Xem thông tin" }
  }
}
